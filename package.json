{
  "name": "@apilow/gamecoin",
  "version": "0.4.0",
  "description": "Server SDK for Apilow GameCoin: the bank of your game (virtual currency, inventory and sales).",
  "keywords": [
    "gamecoin",
    "apilow",
    "virtual-currency",
    "in-game-currency",
    "game-economy",
    "inventory",
    "sdk"
  ],
  "license": "MIT",
  "author": "Apilow",
  "homepage": "https://github.com/apilow/gamecoin-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apilow/gamecoin-node.git"
  },
  "bugs": {
    "url": "https://github.com/apilow/gamecoin-node/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:integration": "node scripts/test.mjs --integration",
    "test:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build && npm test && npm run test:package"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  }
}
